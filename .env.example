# Configuración de Base de Datos
# Para Neon (PostgreSQL): postgresql://user:password@host/dbname?sslmode=require
# Para PostgreSQL local: postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_URL=postgresql+asyncpg://testuser:testpass@localhost:5432/testdb

# Configuración de la Aplicación
PROJECT_NAME=Mi API
DEBUG=True
PORT=8000
